wait-serial "AGK language_ready" 600
press right 1
wait 24
press fire 1
wait-serial "AGK title_ready" 600
press fire 1
wait-serial "AGK combat_ready" 1000
press fire 55
screenshot ready
mark release
wait 12
screenshot lance
wait 10
mark aftermath
expect-serial "AGK sfx charge"
expect-serial "AGK sfx lance"
expect-color lance 120 138 0xFFF near 6
expect-sound release aftermath
expect-no-serial "ERR|STACK SMASHED|allocation failure"
