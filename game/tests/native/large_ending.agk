# Hold during WIN preparation: it cannot arm or dismiss the ending.
wait-serial "AGK qa_transition=3 level=4 phase=5 " 300
hold fire
wait-serial "AGK cut_visible=22 phase=5 " 1000
screenshot ending_first
wait-serial "AGK qa_scene=12 " 1000
screenshot scene12
wait 1
screenshot ending_next_buffer
wait-serial "AGK qa_scene_static=12 " 100
screenshot scene12_late
wait-serial "AGK qa_complete=8191 " 300
wait 100
screenshot ending_held
release
wait 2
screenshot ending_released
press fire 1
wait-serial "AGK scene_ready" 1000
screenshot restarted_opening
key 0x45
wait-serial "AGK title_ready" 600
screenshot returned_title
expect-serial "AGK qa_NON_SHIPPING_injected_fixture"
expect-no-serial "qa_fail=|bullet_hidden=[1-9]|ERR|STACK SMASHED|allocation failure"
