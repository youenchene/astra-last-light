wait-serial "AGK language_ready" 600
press right 1
wait 24
press fire 1
wait-serial "AGK title_ready" 600
mark music
wait 100
mark playing
expect-serial "AGK music theme"
expect-sound music playing
# M toggles music. On the idle title there are no gameplay SFX.
key 0x37
wait 40
mark muted
wait 60
mark silence
expect-silence muted silence
key 0x37
wait 40
mark resumed
wait 60
mark endmusic
expect-sound resumed endmusic
expect-no-serial "ERR|STACK SMASHED|allocation failure"
