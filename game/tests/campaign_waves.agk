# Natural first formation, no firing or state injection: all six remain alive.
# Captures bracket a six-member barrage; serial perf windows include entry/exit.
wait-serial "AGK language_ready" 600
press right 1
wait 24
press fire 1
wait-serial "AGK title_ready" 600
press fire 1
wait-serial "scene_ready=1" 600
screenshot sector_intro
# Same-record opening clocks/readiness and barrage: verify-sector-state.py via tools/agk.
wait-serial "AGK combat_ready" 1000
wait 50
screenshot six_ships
expect-color six_ships 288 68 0xA43
expect-color six_ships 264 95 0xA43
expect-color six_ships 288 122 0xA43
expect-color six_ships 264 149 0xA43
expect-color six_ships 288 176 0xA43
expect-color six_ships 264 203 0xA43
mark barrage_entry
wait 100
screenshot six_barrage
mark barrage_exit
wait 50
screenshot after_barrage
expect-no-serial "bullet_hidden=[1-9]|ERR|STACK SMASHED|allocation failure"
expect-serial "AGK music sector1"
expect-sound barrage_entry barrage_exit
